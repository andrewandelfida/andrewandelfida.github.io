{
  "name": "andrewandelfida-invitation",
  "version": "1.0.0",
  "description": "Wedding invitation site for Андрій та Ельфіда / Andrei și Elfida / Andrew & Elfida — 3 October 2026",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "fonts": "node scripts/fetch-fonts.mjs",
    "images": "node scripts/generate-images.mjs",
    "check:glyphs": "node scripts/check-glyphs.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "build:client": "tsc -b --noEmit && vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "serve": "node scripts/serve.mjs",
    "shots": "node scripts/shots.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "verify": "npm run check:contrast && npm run test:e2e && npm run check:glyphs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "leaflet": "^1.9.4",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.33.5",
    "subset-font": "^2.5.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "sharp@0.33.5": true
  }
}
